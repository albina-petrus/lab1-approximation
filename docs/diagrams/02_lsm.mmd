flowchart TD
    A([Початок: fitLSM points, m]) --> B["Нормалізація x → u ∈ [−1; 1]"]
    B --> C["Дизайн-матриця Вандермонда X (N × (m+1)): X_ij = u_i^j"]
    C --> D["R = X, d = y, j = 0"]
    D --> E{"j ≤ m ?"}
    E -- Так --> F["α = −sign(R_jj)·‖R[j:N, j]‖"]
    F --> G["v = R[j:N, j] − α·e₁,  v = v / ‖v‖"]
    G --> H["R[j:N, j:m] −= 2·v·(vᵀ·R[j:N, j:m])"]
    H --> I["d[j:N] −= 2·v·(vᵀ·d[j:N])"]
    I --> J["j = j + 1"]
    J --> E
    E -- Ні --> K["Зворотна підстановка: a_i = (d_i − Σ R_ic·a_c) / R_ii, i = m..0"]
    K --> L["ŷ_i = P(u_i), r_i = y_i − ŷ_i"]
    L --> M["SSE, MSE, RMSE, max|r|, R²"]
    M --> N["Перерахунок коефіцієнтів у базис x"]
    N --> O([Повернути a, ŷ, r, метрики])
